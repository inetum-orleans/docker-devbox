#!/usr/bin/env bash

DOCKER_DEVBOX_HOME="${DOCKER_DEVBOX_HOME:-$HOME/.docker-devbox}"
DOCKER_DEVBOX_BIN="${DOCKER_DEVBOX_HOME}/bin"
DOCKER_DEVBOX_DOT_BIN="${DOCKER_DEVBOX_HOME}/.bin"
DOCKER_DEVBOX_SRC="${DOCKER_DEVBOX_HOME}/.src"
DOCKER_DEVBOX_KEPT="${DOCKER_DEVBOX_HOME}/.kept"
export DOCKER_DEVBOX_REVERSE_PROXY_NETWORK="${DOCKER_DEVBOX_REVERSE_PROXY_NETWORK:-reverse-proxy}"
DOCKER_DEVBOX_DDB_ASSET_NAME="${DOCKER_DEVBOX_DDB_ASSET_NAME:-ddb-linux}"
_DDB_DEFAULT_REPOSITORY="inetum-orleans/docker-devbox-ddb"
DOCKER_DEVBOX_DDB_REPOSITORY="${DOCKER_DEVBOX_DDB_REPOSITORY:-$_DDB_DEFAULT_REPOSITORY}"
DOCKER_DEVBOX_REPOSITORY="${DOCKER_DEVBOX_REPOSITORY:-https://github.com/inetum-orleans/docker-devbox.git}"
DOCKER_DEVBOX_BRANCH="${DOCKER_DEVBOX_BRANCH:-master}"

if [[ -n "${DOCKER_DEVBOX_CI}" ]]; then
  DOCKER_DEVBOX_MINIMAL=1
  DOCKER_DEVBOX_DISABLE_OPTIONAL_DEPENDENCIES=1
fi

if [[ -z "${DOCKER_DEVBOX_MINIMAL}" ]]; then
  DOCKER_DEVBOX_SMARTCD_BRANCH="${DOCKER_DEVBOX_SMARTCD_BRANCH:-master}"
  DOCKER_DEVBOX_CFSSL_ENABLED=1
  DOCKER_DEVBOX_PORTAINER_ENABLED=1
  DOCKER_DEVBOX_TRAEFIK_ENABLED=1
fi

if [[ -n "${DOCKER_DEVBOX_DISABLE_SMARTCD}" ]]; then
  DOCKER_DEVBOX_SMARTCD_BRANCH=""
fi

if [[ -n "${DOCKER_DEVBOX_DISABLE_CFSSL}" ]]; then
  DOCKER_DEVBOX_CFSSL_ENABLED=""
fi

if [[ -n "${DOCKER_DEVBOX_DISABLE_PORTAINER}" ]]; then
  DOCKER_DEVBOX_PORTAINER_ENABLED=""
fi

if [[ -n "${DOCKER_DEVBOX_DISABLE_REVERSE_PROXY}" ]]; then
  DOCKER_DEVBOX_TRAEFIK_ENABLED=""
fi

# Services are shipped in this repository. When the installer runs from a checkout, use it as is,
# otherwise clone the repository into a cache directory.
if [[ -f "${BASH_SOURCE[0]}" ]] && [[ -d "$(dirname "${BASH_SOURCE[0]}")/services" ]]; then
  DOCKER_DEVBOX_SOURCES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
else
  DOCKER_DEVBOX_SOURCES=""
fi

mkdir -p "${DOCKER_DEVBOX_HOME}"

_LOG="${DOCKER_DEVBOX_HOME}/docker-devbox-installer.log"

echo "">"$_LOG"

if [[ -d "$DOCKER_DEVBOX_HOME/cache" ]]; then
  echo "Clearing cache from previous installation" 2>&1 |& tee -a "$_LOG"
  rm -rf "$DOCKER_DEVBOX_HOME/cache" &>> "$_LOG"
fi

if [[ $EUID -eq 0 ]] && [[ -z "${DOCKER_DEVBOX_ALLOW_ROOT}" ]]
then
  echo "Please run as non-root user or set DOCKER_DEVBOX_ALLOW_ROOT environment variable." 2>&1 | tee -a "$_LOG"
  exit 1
fi

if [[ $EUID -eq 0 ]]; then
  SUDO_EXE=""
else
  SUDO_EXE=$(command -v sudo)
  if [[ ! -x "$SUDO_EXE" ]]; then
    echo "sudo is not available." 2>&1 | tee -a "$_LOG"
  fi
fi

if [[ -z "${DOCKER_DEVBOX_SKIP_DOCKER_CHECKS}" ]] && [[ ! -x $(command -v docker) ]]; then
  echo "Please install docker before installing docker devbox."
  exit 1
fi

if [[ -n "$(command -v apt-get)" ]]; then
  PACKAGE_INSTALL_COMMAND="apt-get -y install"
elif [[ -n "$(command -v yum)" ]]; then
  PACKAGE_INSTALL_COMMAND="yum -y install"
elif [[ -n "$(command -v apk)" ]]; then
  PACKAGE_INSTALL_COMMAND="apk add"
else
  PACKAGE_INSTALL_COMMAND=""
fi

_install_package_if_missing() {
  local PACKAGE="$1"

  if [[ ! -x $(command -v "$PACKAGE") ]]; then
    if [[ ! -x "$SUDO_EXE" && $EUID -ne 0 ]]; then
      echo "Sudo is not available to install $PACKAGE. Install '$PACKAGE' package manually and run the installer again."
      exit 1
    fi
    if [[ -z "$PACKAGE_INSTALL_COMMAND" ]]; then
      echo "No package manager found to install $PACKAGE. Install '$PACKAGE' package manually and run the installer again."
      exit 1
    fi

    echo "Install $PACKAGE" 2>&1 | tee -a "$_LOG"
    $SUDO_EXE $PACKAGE_INSTALL_COMMAND $PACKAGE &>> "$_LOG"
  fi
}

_fetch_sources() {
  if [[ -n "$DOCKER_DEVBOX_SOURCES" ]]; then
    return 0
  fi

  echo "Download docker-devbox sources ($DOCKER_DEVBOX_BRANCH)" 2>&1 |& tee -a "$_LOG"
  rm -rf "$DOCKER_DEVBOX_SRC" &>> "$_LOG"
  if ! git clone --depth 1 -b "$DOCKER_DEVBOX_BRANCH" "$DOCKER_DEVBOX_REPOSITORY" "$DOCKER_DEVBOX_SRC" &>> "$_LOG"; then
    echo "Can't clone $DOCKER_DEVBOX_REPOSITORY ($DOCKER_DEVBOX_BRANCH)." 2>&1 | tee -a "$_LOG"
    exit 1
  fi

  DOCKER_DEVBOX_SOURCES="$DOCKER_DEVBOX_SRC"
}

# ddb self-update reads the repository from core.github_repository, keep it aligned with the installed binary.
_configure_ddb_repository() {
  local CONFIG="${DOCKER_DEVBOX_HOME}/ddb.yml"

  if [[ -e "${DOCKER_DEVBOX_HOME}/ddb.yaml" ]]; then
    CONFIG="${DOCKER_DEVBOX_HOME}/ddb.yaml"
  fi

  if [[ ! -e "$CONFIG" ]]; then
    if [[ "$DOCKER_DEVBOX_DDB_REPOSITORY" == "$_DDB_DEFAULT_REPOSITORY" ]]; then
      return 0
    fi

    echo "Configure ddb to self-update from ${DOCKER_DEVBOX_DDB_REPOSITORY}" 2>&1 |& tee -a "$_LOG"
    cat << EOF > "$CONFIG"
core:
  github_repository: $DOCKER_DEVBOX_DDB_REPOSITORY
EOF
    return 0
  fi

  if awk -v repository="$DOCKER_DEVBOX_DDB_REPOSITORY" '
    BEGIN { in_core = 0; inline_core = 0; done = 0 }
    !done && /^core:[ \t]*$/ { in_core = 1; print; next }
    !done && /^core:[ \t]*[^ \t]/ { inline_core = 1; print; next }
    in_core && /^[ \t]+github_repository:[ \t]*/ {
      match($0, /^[ \t]+/)
      print substr($0, 1, RLENGTH) "github_repository: " repository
      in_core = 0; done = 1; next
    }
    in_core && /^[^ \t]/ { print "  github_repository: " repository; in_core = 0; done = 1 }
    { print }
    END {
      if (in_core) { print "  github_repository: " repository; done = 1 }
      if (!done && !inline_core) { print "core:"; print "  github_repository: " repository; done = 1 }
      if (!done) { exit 2 }
    }
  ' "$CONFIG" > "$CONFIG.tmp"; then
    if ! cmp -s "$CONFIG" "$CONFIG.tmp"; then
      echo "Configure ddb to self-update from ${DOCKER_DEVBOX_DDB_REPOSITORY}" 2>&1 |& tee -a "$_LOG"
      mv "$CONFIG.tmp" "$CONFIG"
    else
      rm -f "$CONFIG.tmp"
    fi
  else
    rm -f "$CONFIG.tmp"
    echo "Set core.github_repository to ${DOCKER_DEVBOX_DDB_REPOSITORY} in $CONFIG for ddb self-update to use the same repository." 2>&1 | tee -a "$_LOG"
  fi
}

# Paths of a service directory that hold local configuration or state, and are worth surviving a reinstallation.
_service_kept_paths() {
  local SERVICE="$1"

  echo "ddb.local.yml"
  echo "ddb.local.yaml"

  if [[ "$SERVICE" == "traefik" ]]; then
    echo "acme.json"
  fi

  # Those certificates are signed by the certificate authority, and are meaningless once it is reissued.
  if [[ -z "${DOCKER_DEVBOX_RESET}" ]]; then
    echo ".certs"

    if [[ "$SERVICE" == "traefik" ]]; then
      echo "config"
    fi
  fi
}

_keep_service_files() {
  local SERVICE="$1"
  local TARGET="$DOCKER_DEVBOX_HOME/$SERVICE"
  local KEPT="$DOCKER_DEVBOX_KEPT/$SERVICE"
  local KEPT_PATH

  rm -rf "$KEPT" &>> "$_LOG"

  while read -r KEPT_PATH; do
    if [[ ! -e "$TARGET/$KEPT_PATH" ]]; then
      continue
    fi

    echo "Keep $SERVICE/$KEPT_PATH" 2>&1 |& tee -a "$_LOG"
    mkdir -p "$KEPT/$(dirname "$KEPT_PATH")" &>> "$_LOG"
    cp -a "$TARGET/$KEPT_PATH" "$KEPT/$KEPT_PATH" &>> "$_LOG"
  done < <(_service_kept_paths "$SERVICE")
}

_restore_service_files() {
  local SERVICE="$1"
  local TARGET="$DOCKER_DEVBOX_HOME/$SERVICE"
  local KEPT="$DOCKER_DEVBOX_KEPT/$SERVICE"

  if [[ ! -d "$KEPT" ]]; then
    return 0
  fi

  cp -a "$KEPT/." "$TARGET/" &>> "$_LOG"
  rm -rf "$KEPT" &>> "$_LOG"
  rmdir "$DOCKER_DEVBOX_KEPT" &> /dev/null || true
}

_uninstall_service() {
  local SERVICE="$1"
  local TARGET="$DOCKER_DEVBOX_HOME/$SERVICE"

  if [[ ! -d "$TARGET" ]]; then
    return 0
  fi

  _keep_service_files "$SERVICE"

  echo "Stop $SERVICE" 2>&1 |& tee -a "$_LOG"
  cd "$TARGET" &>> "$_LOG"

  if [[ -n "${DOCKER_DEVBOX_RESET}" ]]; then
    echo "Remove $SERVICE volumes" 2>&1 |& tee -a "$_LOG"
    docker compose down --remove-orphans --volumes &>> "$_LOG"
  else
    docker compose down --remove-orphans &>> "$_LOG"
  fi

  cd "$HOME" &>> "$_LOG"
  rm -rf "$TARGET" &>> "$_LOG"
}

_copy_service() {
  local SERVICE="$1"
  local TARGET="$DOCKER_DEVBOX_HOME/$SERVICE"

  _fetch_sources

  if [[ ! -d "$DOCKER_DEVBOX_SOURCES/services/$SERVICE" ]]; then
    echo "Service $SERVICE not found in $DOCKER_DEVBOX_SOURCES/services." 2>&1 | tee -a "$_LOG"
    exit 1
  fi

  mkdir -p "$TARGET" &>> "$_LOG"
  cp -a "$DOCKER_DEVBOX_SOURCES/services/$SERVICE/." "$TARGET/" &>> "$_LOG"
  _restore_service_files "$SERVICE"
}

_install_package_if_missing "git"
_install_package_if_missing "make"

mkdir -p $DOCKER_DEVBOX_BIN
mkdir -p $DOCKER_DEVBOX_DOT_BIN

if [[ -f "$HOME/.bashrc" ]]; then
  cat "$HOME/.bashrc" | grep "export PATH=\"$DOCKER_DEVBOX_BIN:$DOCKER_DEVBOX_DOT_BIN:\$PATH\"" &> /dev/null
  BASH_RC_CONFIGURED=$?
  if [[ "$BASH_RC_CONFIGURED" -ne 0 ]]; then
    echo "Add $DOCKER_DEVBOX_BIN and $DOCKER_DEVBOX_DOT_BIN to path (.bashrc)" 2>&1 |& tee -a "$_LOG"

    cat << EOF >> "$HOME/.bashrc"

# Add docker-devbox bin to PATH
export PATH="$DOCKER_DEVBOX_BIN:$DOCKER_DEVBOX_DOT_BIN:\$PATH"
EOF
  fi
elif [[ -f "$HOME/.bash_profile" ]]; then
  cat "$HOME/.bash_profile" | grep "export PATH=\"$DOCKER_DEVBOX_BIN:$DOCKER_DEVBOX_DOT_BIN:\$PATH\"" &> /dev/null
  BASH_PROFILE_CONFIGURED=$?
  if [[ "$BASH_PROFILE_CONFIGURED" -ne 0 ]]; then
    echo "Add $DOCKER_DEVBOX_BIN and $DOCKER_DEVBOX_DOT_BIN to path (.bash_profile)" 2>&1 |& tee -a "$_LOG"

    cat << EOF >> "$HOME/.bash_profile"

# Add docker-devbox bin to PATH
export PATH="$DOCKER_DEVBOX_BIN:$DOCKER_DEVBOX_DOT_BIN:\$PATH"
EOF
  fi
fi

export PATH="$DOCKER_DEVBOX_BIN:$PATH"

if [[ -n "${DOCKER_DEVBOX_DISABLE_DDB}" ]]; then
  if [[ ! -x "$DOCKER_DEVBOX_BIN/ddb" ]] && [[ ! -x "$(command -v ddb)" ]]; then
    echo "ddb download is disabled, but no ddb binary is available. Install one in $DOCKER_DEVBOX_BIN or unset DOCKER_DEVBOX_DISABLE_DDB." 2>&1 | tee -a "$_LOG"
    exit 1
  fi

  echo "ddb download is disabled, keeping $(command -v ddb)" 2>&1 |& tee -a "$_LOG"
else
  if [[ -n "${DOCKER_DEVBOX_DDB_URL}" ]]; then
    echo "Downloading ddb from ${DOCKER_DEVBOX_DDB_URL}" 2>&1 |& tee -a "$_LOG"
    DOCKER_DEVBOX_BIN_URL="${DOCKER_DEVBOX_DDB_URL}"
  elif [[ -n "${DOCKER_DEVBOX_DDB_VERSION}" ]]; then
    echo "Downloading ddb version ${DOCKER_DEVBOX_DDB_VERSION} from ${DOCKER_DEVBOX_DDB_REPOSITORY}" 2>&1 |& tee -a "$_LOG"
    DOCKER_DEVBOX_BIN_URL="https://github.com/${DOCKER_DEVBOX_DDB_REPOSITORY}/releases/download/${DOCKER_DEVBOX_DDB_VERSION}/${DOCKER_DEVBOX_DDB_ASSET_NAME}"
  else
    echo "Downloading ddb latest release from ${DOCKER_DEVBOX_DDB_REPOSITORY}" 2>&1 |& tee -a "$_LOG"
    DOCKER_DEVBOX_BIN_URL=$(curl -fsSL $DOCKER_DEVBOX_CURL_OPTS_GITHUB_API "https://api.github.com/repos/${DOCKER_DEVBOX_DDB_REPOSITORY}/releases/latest" \
    | grep "browser_download_url.*/$DOCKER_DEVBOX_DDB_ASSET_NAME\"" \
    | cut -d : -f 2,3 \
    | tr -d ' "')

    if [[ -z "${DOCKER_DEVBOX_BIN_URL}" ]]; then
      # Github API may fail, most commonly because of unauthenticated rate limit.
      # Use git to retrieve latest release tag and build url manually.
      DOCKER_DEVBOX_LATEST_RELEASE=$(git -c 'versionsort.suffix=-' \
          ls-remote --exit-code --refs --sort='version:refname' --tags "https://github.com/${DOCKER_DEVBOX_DDB_REPOSITORY}" 'v*.*.*' \
          | tail --lines=1 \
          | cut --delimiter='/' --fields=3)

      if [[ -z "${DOCKER_DEVBOX_LATEST_RELEASE}" ]]; then
          echo "Can't find ${DOCKER_DEVBOX_DDB_REPOSITORY} last release." 2>&1 | tee -a "$_LOG"
          exit 1
      fi

      DOCKER_DEVBOX_BIN_URL="https://github.com/${DOCKER_DEVBOX_DDB_REPOSITORY}/releases/download/${DOCKER_DEVBOX_LATEST_RELEASE}/${DOCKER_DEVBOX_DDB_ASSET_NAME}"
    fi
  fi

  if ! curl -fsSL -o "$DOCKER_DEVBOX_BIN/ddb" "$DOCKER_DEVBOX_BIN_URL"; then
    rm -f "$DOCKER_DEVBOX_BIN/ddb"
    echo "Can't download ddb from $DOCKER_DEVBOX_BIN_URL." 2>&1 | tee -a "$_LOG"
    exit 1
  fi

  chmod +x "$DOCKER_DEVBOX_BIN/ddb"
fi

_configure_ddb_repository

if [[ -z "${DOCKER_DEVBOX_DISABLE_OPTIONAL_DEPENDENCIES}" ]]; then
    _MKCERT_VERSION=$(curl -fsSL $DOCKER_DEVBOX_CURL_OPTS_GITHUB_API https://api.github.com/repos/FiloSottile/mkcert/releases/latest | grep 'tag_name' | cut -d\" -f4)
    _MKCERT_INSTALL=1
    if [[ -f "$DOCKER_DEVBOX_BIN"/.mkcert.version ]]; then
        if [[ $(cat "$DOCKER_DEVBOX_BIN"/.mkcert.version) == "${_MKCERT_VERSION}" ]]; then
          _MKCERT_INSTALL=0
        fi
    fi

    if [[ "$_MKCERT_INSTALL" -ne 0 ]]; then
      _install_package_if_missing "curl"

      echo "Install mkcert ($_MKCERT_VERSION)" 2>&1 |& tee -a "$_LOG"
      curl -fsSL -o "$DOCKER_DEVBOX_BIN"/mkcert "https://github.com/FiloSottile/mkcert/releases/download/$_MKCERT_VERSION/mkcert-$_MKCERT_VERSION-linux-amd64" &>> "$_LOG"
      chmod +x "$DOCKER_DEVBOX_BIN"/mkcert &>> "$_LOG"

      echo "$_MKCERT_VERSION" >> "$DOCKER_DEVBOX_BIN"/.mkcert.version
    fi
fi

echo "Create $DOCKER_DEVBOX_REVERSE_PROXY_NETWORK docker network" 2>&1 |& tee -a "$_LOG"
docker network create "$DOCKER_DEVBOX_REVERSE_PROXY_NETWORK" &>> "$_LOG" || true

if [[ -n "${DOCKER_DEVBOX_SMARTCD_BRANCH}" ]]; then
    echo "Install SmartCD" 2>&1 |& tee -a "$_LOG"
    cd /tmp &>> "$_LOG"
    rm -Rf smartcd &>> "$_LOG"
    git clone -b ${DOCKER_DEVBOX_SMARTCD_BRANCH} https://github.com/inetum-orleans/smartcd.git &>> "$_LOG"
    cd smartcd &>> "$_LOG"
    make install &>> "$_LOG"
    source load_smartcd &>> "$_LOG"
    rm -Rf smartcd &>> "$_LOG"
    cd $HOME &>> "$_LOG"

    if [[ ! -f "$HOME/.smartcd_config" ]]; then
        cat << 'EOF' > $HOME/.smartcd_config
# Load and configure smartcd
source $HOME/.smartcd/lib/core/arrays
source $HOME/.smartcd/lib/core/varstash
source $HOME/.smartcd/lib/core/smartcd
# smartcd setup chpwd-hook
smartcd setup cd
smartcd setup pushd
smartcd setup popd
# smartcd setup prompt-hook
# smartcd setup exit-hook
smartcd setup completion
# VARSTASH_AUTOCONFIGURE=1
# VARSTASH_AUTOEDIT=1
# SMARTCD_NO_INODE=1
# SMARTCD_AUTOMIGRATE=1
SMARTCD_LEGACY=1
SMARTCD_QUIET=1
# VARSTASH_QUIET=1
EOF
        echo "SmartCD configuration file has been written (~/.smartcd_config)" 2>&1 |& tee -a "$_LOG"
    fi

    cat $HOME/.bashrc | grep .smartcd_config &> /dev/null
    BASHRC_CONFIGURED=$?
    if [[ "$BASHRC_CONFIGURED" -ne 0 ]]; then
        cat << 'EOF' >> "$HOME/.bashrc"

# SmartCD Configuration
[ -r "$HOME/.smartcd_config" ] && ( [ -n $BASH_VERSION ] || [ -n $ZSH_VERSION ] ) && source $HOME/.smartcd_config
EOF
        echo "SmartCD registered (~/.bashrc)" 2>&1 |& tee -a "$_LOG"
    fi
else
    echo "SmartCD is disabled" 2>&1 |& tee -a "$_LOG"
fi

# Traefik
if [[ -d "$DOCKER_DEVBOX_HOME/traefik" ]]; then
    _uninstall_service traefik

    if [[ -n "${DOCKER_DEVBOX_RESET}" ]]; then
      rm -rf "$DOCKER_DEVBOX_HOME"/certs &>> "$_LOG"
    fi
fi

if [[ -n "${DOCKER_DEVBOX_TRAEFIK_ENABLED}" ]]; then
    echo "Use traefik as reverse proxy" 2>&1 |& tee -a "$_LOG"
    _copy_service traefik
    cd "${DOCKER_DEVBOX_HOME}"/traefik &>> "$_LOG"
    echo "Install traefik" 2>&1 |& tee -a "$_LOG"
    touch acme.json
    mkdir -p "$DOCKER_DEVBOX_HOME"/certs
    ddb configure &>> "$_LOG" || true
    docker compose pull &>> "$_LOG" || true
    echo "Start traefik" 2>&1 |& tee -a "$_LOG"
    docker compose up --build -d &>> "$_LOG"
    cd $HOME &>> "$_LOG"
else
    echo "Reverse proxy is disabled" 2>&1 |& tee -a "$_LOG"
fi

# CFSSL
_uninstall_service cfssl

if [[ -n "${DOCKER_DEVBOX_CFSSL_ENABLED}" ]]; then
    echo "Install CFSSL" 2>&1 |& tee -a "$_LOG"
    _copy_service cfssl
    cd "${DOCKER_DEVBOX_HOME}"/cfssl &>> "$_LOG"
    ddb configure &>> "$_LOG"
    docker compose pull &>> "$_LOG"
    echo "Start CFSSL" 2>&1 |& tee -a "$_LOG"
    docker compose up --build -d &>> "$_LOG"
    cd $HOME &>> "$_LOG"
else
    echo "CFSSL is disabled" 2>&1 |& tee -a "$_LOG"
fi

# Portainer
_uninstall_service portainer

if [[ -n "${DOCKER_DEVBOX_PORTAINER_ENABLED}" ]]; then
    echo "Install portainer" 2>&1 |& tee -a "$_LOG"
    _copy_service portainer
    cd "${DOCKER_DEVBOX_HOME}"/portainer &>> "$_LOG"
    ddb configure &>> "$_LOG" || true
    docker compose pull &>> "$_LOG" || true
    echo "Start portainer" 2>&1 |& tee -a "$_LOG"
    docker compose up --build -d &>> "$_LOG"
    cd $HOME &>> "$_LOG"
else
    echo "Portainer is disabled" 2>&1 |& tee -a "$_LOG"
fi

echo "Docker Devbox installation is terminated." 2>&1 |& tee -a "$_LOG"


if [[ -f $HOME/.smartcd_config ]]; then
  source $HOME/.smartcd_config
fi
